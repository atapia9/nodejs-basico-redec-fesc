{
  // Configuración permisiva: el Markdown es una conversión fiel del manual en Word
  // y se conserva su estructura y su texto en español.
  "config": {
    "default": true,
    "MD013": false, // longitud de línea: los párrafos del manual son largos
    "MD024": { "siblings_only": true }, // encabezados repetidos en secciones distintas
    "MD025": false, // varios H1 por archivo: cada apartado del manual es un H1
    "MD033": false, // HTML en línea: se usa <br> dentro de celdas de tablas
    "MD034": false, // URLs sin enlazar: el manual las escribe como texto
    "MD036": false, // énfasis usado como título
    "MD041": false // el primer elemento no siempre es un H1
  },
  "ignores": [
    "fuentes/**",
    "node_modules/**",
    "evaluacion/_clave-instructor.md"
  ]
}
